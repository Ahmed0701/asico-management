# Demo mode (npm run demo): built app uses a relative API URL; Vite preview proxies /api to the local backend.
# Copy to .env.demo.local for machine-specific overrides (.env.demo.local is gitignored if listed in .gitignore).

# Browser-facing API prefix (must match asico-server mount: /api/v1).
VITE_API_BASE_URL=/api/v1

# Preview/dev proxy target. Must match asico-server PORT.
DEV_API_PROXY_TARGET=http://localhost:8080
