# Copy to .env for local overrides (.env is gitignored).
#
# Production builds do not require env vars: the app calls /api/v1 on the same origin.
# Deploy the static dist/ behind a reverse proxy that forwards /api to asico-server.
#
# Optional: override the API prefix baked into the client (default /api/v1).
# VITE_API_BASE_URL=/api/v1
#
# Development: Vite proxies browser requests from /api to the backend (see vite.config.ts).

# Backend origin for the dev proxy. Must match asico-server PORT and CORS_ORIGINS must include
# this app's dev origin (default http://localhost:5173).
DEV_API_PROXY_TARGET=http://localhost:8080
